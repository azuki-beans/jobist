# --- Claude API (https://console.anthropic.com) -------------------------------
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5
# low | medium | high | xhigh | max: più alto = ricerca più accurata e più costosa
ANTHROPIC_EFFORT=high

# --- Notifiche (Apprise) -------------------------------------------------------
# Uno o più URL separati da spazio o virgola. Formati: https://github.com/caronc/apprise/wiki
# Esempi:
#   mailtos://utente:password@smtp.example.com?to=io@example.com   (SMTP)
#   resend://...  brevo://...  sendgrid://...  ses://...           (API email)
#   tgram://BOT_TOKEN/CHAT_ID                                       (Telegram)
#   ntfy://ntfy.sh/mio-topic-segreto                                (ntfy)
NOTIFY_URLS=

# --- Criteri di ricerca (i campi vuoti vengono ignorati) ----------------------
# JOB_SEARCH_QUERY: profilo in testo libero (settori preferiti, stile di lavoro), sempre
# incluso insieme ai criteri strutturati. Basta anche da solo.
JOB_SEARCH_QUERY=
JOB_SEARCH_RUOLO=Backend developer
JOB_SEARCH_STACK=Python, Django, PostgreSQL
JOB_SEARCH_SENIORITY=Senior
JOB_SEARCH_MODALITA=remoto
JOB_SEARCH_LOCALITA=Italia
JOB_SEARCH_RAL_MINIMA=
JOB_SEARCH_ESCLUSIONI=agenzie di recruiting, stage
# Scarta annunci pubblicati da più di N giorni
JOB_SEARCH_GIORNI=14
JOB_SEARCH_MAX_RISULTATI=10

# --- Tool web_search -----------------------------------------------------------
WEB_SEARCH_MAX_USES=8
# CSV; allowed e blocked sono alternativi (allowed ha la precedenza)
WEB_SEARCH_ALLOWED_DOMAINS=
WEB_SEARCH_BLOCKED_DOMAINS=
WEB_SEARCH_COUNTRY=IT
WEB_SEARCH_CITY=
WEB_SEARCH_REGION=
TIMEZONE=Europe/Rome

# --- Database --------------------------------------------------------------------
JOBIST_DB_PATH=jobist.sqlite3
# Su Cloud Run: il file viene scaricato da qui all'avvio e ricaricato alla fine
JOBIST_DB_GCS_URI=
